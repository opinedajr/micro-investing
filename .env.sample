# Server Configuration
SERVER_PORT=3003

# Database Configuration
# DB_DRIVER: postgres | mysql | sqlite
DB_DRIVER=sqlite

# Required when DB_DRIVER is postgres or mysql.
# When DB_DRIVER=sqlite, only DB_NAME is required and it is the database file path.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Brapi Configuration (quotation price sync job)
# BRAPI_API_KEY: required only by the quotation sync job; the API server starts without it
BRAPI_API_KEY=
BRAPI_BASE_URL=https://brapi.dev
BRAPI_TIMEOUT=15s
BRAPI_BATCH_SIZE=1
